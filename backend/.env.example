DATABASE_URL=postgresql://username:password@localhost:5432/database_name
APP_NAME=MedLens API
APP_ENV=development
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
# Comma-separated deployed frontend origins, e.g. https://app.example.com
# Local Vite dev servers (any localhost/127.0.0.1 port) are allowed
# automatically when APP_ENV=development and do not need to be listed here.
CORS_ALLOWED_ORIGINS=