DATABASE_URL=postgresql://username:password@localhost:5432/database_name
APP_NAME=MedLens API
APP_ENV=development
# Reported by GET /health (Issue #61) - purely informational.
APP_VERSION=1.0.0
# Root logger level (Issue #59) - see docs/deployment.md's "Structured
# Application Logging" section. "DEBUG" also surfaces third-party
# libraries' own debug output (e.g. SQLAlchemy query logs).
LOG_LEVEL=INFO
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Which AIProvider get_ai_summary_service() constructs - "gemini" (the
# default), "openbiollm", or "medgemma". Fails at startup if set to
# anything else. An existing .env with no AI_PROVIDER line at all keeps
# using Gemini unchanged.
AI_PROVIDER=gemini

# Only used when AI_PROVIDER=openbiollm or AI_PROVIDER=medgemma - both
# are served by a local Ollama daemon (https://ollama.com), not a hosted
# API, so neither requires a credential of any kind. Without a reachable
# Ollama server at this address, either provider starts normally but
# POST /patients/{id}/analyses returns a 503 with a clear error, the same
# tradeoff GEMINI_API_KEY already makes. See docs/ai.md.
OLLAMA_BASE_URL=http://localhost:11434

# Which local Ollama model to call for OpenBioLLM - see
# infra/ollama/openbiollm-llama3-instruct.Modelfile for how this exact
# model is built (from the same OpenBioLLM-Llama3-8B Q4_K_M weights, with
# the correct Llama 3 Instruct chat template attached) and
# backend/app/ai/providers/openbiollm_provider.py for why the raw GGUF
# import isn't used directly. Only relevant when AI_PROVIDER=openbiollm.
OPENBIOLLM_MODEL=openbiollm-llama3-instruct

# Which MedGemma checkpoint to call, pulled directly via Ollama's
# Hugging Face GGUF integration - see
# backend/app/ai/providers/medgemma_provider.py. Only relevant when
# AI_PROVIDER=medgemma.
MEDGEMMA_MODEL=hf.co/bartowski/google_medgemma-4b-it-GGUF:Q4_K_M

# Where uploaded clinical document files are stored (Issue #58) - "local"
# (the default) or "s3". Local development and CI need nothing further
# below; only set STORAGE_BACKEND=s3 (and the AWS_*/S3_* variables below)
# to test against a real S3 bucket. See docs/deployment.md.
STORAGE_BACKEND=local
# Only used when STORAGE_BACKEND=local - where files are written on disk,
# relative to the backend process's working directory unless given as an
# absolute path.
LOCAL_STORAGE_DIR=./storage/clinical_documents

# Only required when STORAGE_BACKEND=s3 - the app fails to start with a
# clear error if either is missing in that case.
AWS_REGION=
S3_BUCKET_NAME=
# Leave both unset to use the AWS SDK's normal credential chain (e.g. an
# IAM role attached to an EC2 instance in production - the recommended
# configuration, see docs/deployment.md's Security section). Only set
# these for local development against a real bucket using your own AWS
# credentials; never commit real values here.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=