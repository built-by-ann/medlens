# Copy this file to infra/.env and fill in real values before deploying.
# infra/.env is gitignored and read automatically by `docker compose` for
# any ${VAR} reference in docker-compose.yml - never commit the real file.
#
# Every variable below has a working default for local development baked
# into docker-compose.yml itself, so `docker compose up --build` from
# infra/ works with no infra/.env file at all. This file only matters once
# you need to override those defaults - most importantly, for any real
# deployment. See docs/deployment.md for the full deployment guide.

# --- Required for any real deployment ---

# A long, random, unique secret used to sign JWT access tokens. The
# default in docker-compose.yml is a well-known placeholder string, fine
# for a throwaway local database, but never acceptable once real user
# accounts exist. Generate one with, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-secret

# The Postgres password, shared between the postgres service and the
# backend's DATABASE_URL (docker-compose.yml references this same
# variable in both places). Change this from the default before deploying.
POSTGRES_PASSWORD=replace-with-a-strong-password

# The frontend image bakes this in at BUILD time (Vite inlines
# import.meta.env.* into the JS bundle). A relative path (Issue #190),
# not an absolute URL - the browser reaches the backend through this same
# nginx container's own reverse proxy (frontend/nginx.conf), not a
# separate host/port, so the default below is correct for both local
# Docker Compose use and any real deployment; there is normally no reason
# to override it. Changing it requires rebuilding the frontend image
# (`docker compose build frontend`), not just restarting the container.
VITE_API_BASE_URL=/api

# Set to "production" for any real deployment. This disables the
# development-only behavior of auto-allowing any localhost/127.0.0.1
# origin for CORS (see backend/app/main.py's configure_cors) - relevant
# only to `npm run dev`'s Vite dev server, which talks to the backend
# directly and cross-origin; every request that goes through the
# reverse proxy above is same-origin and never triggers CORS at all, so
# there is nothing else to configure here for a real deployment. See
# docs/design-decisions.md, Decision 24.
APP_ENV=development

# --- Optional ---

# Reported by GET /health (Issue #61) - a plain string, not derived from
# git or the image tag. Set it to whatever version identifier is
# meaningful for your own deployment process; purely informational.
APP_VERSION=1.0.0

# Root logger level (Issue #59) - see docs/deployment.md's "Structured
# Application Logging" section. "DEBUG" also surfaces third-party
# libraries' own debug output (e.g. SQLAlchemy query logs).
LOG_LEVEL=INFO

# Enables AI-powered clinical document summarization and medication
# extraction. Without it, POST /patients/{id}/analyses returns a 503 with
# a clear error (see docs/api.md) - every other feature works normally.
GEMINI_API_KEY=

# Which Gemini model to call. docker-compose.yml defaults this to the same
# gemini-2.5-flash the backend itself defaults to when GEMINI_MODEL is unset
# entirely, so this line is normally only needed to override it - e.g. if
# Google retires the current default again, this can be changed here
# without rebuilding any image (it's a runtime environment variable, not a
# build-time one - restart the backend after changing it, no rebuild
# needed).
GEMINI_MODEL=gemini-2.5-flash

# Which AIProvider get_ai_summary_service() constructs - "gemini" (the
# default, so this line can be left unset entirely) or "openbiollm". The
# backend fails to start with a clear error if set to anything else.
AI_PROVIDER=gemini

# Only required when AI_PROVIDER=openbiollm - a Hugging Face user access
# token (fine-grained, scoped to "Make calls to Inference Providers" -
# see https://huggingface.co/settings/tokens). Leave blank while using
# Gemini (the default).
HUGGINGFACE_API_KEY=

# Which OpenBioLLM checkpoint to call, via Hugging Face's Inference
# Providers - see docs/ai.md. Only relevant when AI_PROVIDER=openbiollm;
# docker-compose.yml already defaults this to the same value the backend
# itself defaults to when unset, so this line is normally only needed to
# override it.
OPENBIOLLM_MODEL=aaditya/Llama3-OpenBioLLM-8B

# Host port docker-compose.yml publishes the frontend on - the app's only
# public entry point (Issue #190). Defaults to 80, so a deployment is
# reachable at http://<ec2-public-ip>/ with no port suffix out of the box
# (binding host port 80 requires the Docker daemon to have permission to
# do so, which is the normal case on a dedicated EC2 instance). Only ever
# used to redirect to HTTPS and serve Let's Encrypt's renewal challenge
# once HTTPS is set up - see FRONTEND_HTTPS_PORT and DOMAIN below.
FRONTEND_PORT=80

# Host port docker-compose.yml publishes the frontend's HTTPS listener on
# (Issue #189) - the actual port the app is served from once HTTPS is set
# up (docs/deployment.md's HTTPS section). Defaults to 443, so a
# deployment is reachable at https://<domain>/ with no port suffix.
FRONTEND_HTTPS_PORT=443

# The production domain this app is served from (Issue #189) - baked into
# the frontend image at BUILD time (same reasoning as VITE_API_BASE_URL
# above: Vite/nginx.conf both need real build-time values, not
# container-runtime ones). Must match whatever domain you actually run
# certbot for (docs/deployment.md's HTTPS section) - nginx looks for a
# certificate under this exact name inside the certbot_certs volume, so
# the two have to agree. Changing this requires rebuilding the frontend
# image (`docker compose build frontend`), not just restarting it.
DOMAIN=medlenshealth.com

# Host port the backend is published on, bound to 127.0.0.1 only
# (infra/docker-compose.yml) - never reachable from outside this host,
# real deployment or not. This exists so a developer on the host itself
# can still reach the API directly (curl, Postman, `npm run dev`'s Vite
# dev server), not for anything public; the browser never uses this port
# in normal use, only the reverse proxy above.
BACKEND_PORT=8000

# --- File storage (Issue #58) ---

# Uploaded clinical document files default to STORAGE_BACKEND=local -
# written inside the backend container's own filesystem, which does NOT
# survive `docker compose down` or the container being recreated (e.g. on
# every "Updating the application" redeploy, see docs/deployment.md).
# Fine for trying the app out; not acceptable for a real deployment with
# real uploads to keep. Set STORAGE_BACKEND=s3 and the four variables
# below to persist files in S3 instead, which does survive redeploys.
STORAGE_BACKEND=local

# Required only when STORAGE_BACKEND=s3 - see docs/deployment.md's "File
# Storage (S3)" section for bucket creation and IAM policy setup.
AWS_REGION=
S3_BUCKET_NAME=
# Leave both blank on a real EC2 deployment - attach an IAM role to the
# instance instead (docs/deployment.md) rather than putting long-lived
# credentials in this file. Only fill these in for local development
# against a real S3 bucket using your own AWS credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
