# Copy this file to infra/.env and fill in real values before deploying.
# infra/.env is gitignored and read automatically by `docker compose` for
# any ${VAR} reference in docker-compose.yml - never commit the real file.
#
# Every variable below has a working default for local development baked
# into docker-compose.yml itself, so `docker compose up --build` from
# infra/ works with no infra/.env file at all. This file only matters once
# you need to override those defaults - most importantly, for any real
# deployment. See docs/deployment.md for the full deployment guide.

# --- Required for any real deployment ---

# A long, random, unique secret used to sign JWT access tokens. The
# default in docker-compose.yml is a well-known placeholder string, fine
# for a throwaway local database, but never acceptable once real user
# accounts exist. Generate one with, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-secret

# The Postgres password, shared between the postgres service and the
# backend's DATABASE_URL (docker-compose.yml references this same
# variable in both places). Change this from the default before deploying.
POSTGRES_PASSWORD=replace-with-a-strong-password

# The frontend image bakes this in at BUILD time (Vite inlines
# import.meta.env.* into the JS bundle) - it must be the real, publicly
# reachable URL of the backend once deployed, e.g.
# http://<ec2-public-ip>:8000. Changing this requires rebuilding the
# frontend image (`docker compose build frontend`), not just restarting
# the container.
VITE_API_BASE_URL=http://localhost:8000

# Set to "production" for any real deployment. This disables the
# development-only behavior of auto-allowing any localhost/127.0.0.1
# origin for CORS (see backend/app/main.py) - in production, only origins
# listed in CORS_ALLOWED_ORIGINS below are allowed.
APP_ENV=development

# Comma-separated list of frontend origins allowed to call the backend,
# e.g. http://<ec2-public-ip>:8080. Required once APP_ENV=production,
# since the automatic localhost allowance above no longer applies.
CORS_ALLOWED_ORIGINS=

# --- Optional ---

# Reported by GET /health (Issue #61) - a plain string, not derived from
# git or the image tag. Set it to whatever version identifier is
# meaningful for your own deployment process; purely informational.
APP_VERSION=1.0.0

# Root logger level (Issue #59) - see docs/deployment.md's "Structured
# Application Logging" section. "DEBUG" also surfaces third-party
# libraries' own debug output (e.g. SQLAlchemy query logs).
LOG_LEVEL=INFO

# Enables AI-powered clinical document summarization and medication
# extraction. Without it, POST /patients/{id}/analyses returns a 503 with
# a clear error (see docs/api.md) - every other feature works normally.
GEMINI_API_KEY=

# Which Gemini model to call. docker-compose.yml defaults this to the same
# gemini-2.5-flash the backend itself defaults to when GEMINI_MODEL is unset
# entirely, so this line is normally only needed to override it - e.g. if
# Google retires the current default again, this can be changed here
# without rebuilding any image (it's a runtime environment variable, not a
# build-time one - restart the backend after changing it, no rebuild
# needed).
GEMINI_MODEL=gemini-2.5-flash

# Host ports docker-compose.yml publishes the frontend/backend on. Change
# FRONTEND_PORT to 80 for a deployment you want reachable at
# http://<ec2-public-ip>/ with no port suffix (binding host port 80
# requires the Docker daemon to have permission to do so, which is the
# normal case on a dedicated EC2 instance).
FRONTEND_PORT=8080
BACKEND_PORT=8000

# --- File storage (Issue #58) ---

# Uploaded clinical document files default to STORAGE_BACKEND=local -
# written inside the backend container's own filesystem, which does NOT
# survive `docker compose down` or the container being recreated (e.g. on
# every "Updating the application" redeploy, see docs/deployment.md).
# Fine for trying the app out; not acceptable for a real deployment with
# real uploads to keep. Set STORAGE_BACKEND=s3 and the four variables
# below to persist files in S3 instead, which does survive redeploys.
STORAGE_BACKEND=local

# Required only when STORAGE_BACKEND=s3 - see docs/deployment.md's "File
# Storage (S3)" section for bucket creation and IAM policy setup.
AWS_REGION=
S3_BUCKET_NAME=
# Leave both blank on a real EC2 deployment - attach an IAM role to the
# instance instead (docs/deployment.md) rather than putting long-lived
# credentials in this file. Only fill these in for local development
# against a real S3 bucket using your own AWS credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
