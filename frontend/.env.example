# Only for `npm run dev` (the Vite dev server) - this is the one place in
# the whole application that still needs an absolute backend URL (Issue
# #190). The dev server runs directly on your host, outside Docker, with
# no reverse proxy in front of it, so it must reach the backend directly
# and cross-origin; that's also why the backend still runs its CORS
# middleware for local development (see backend/app/main.py's
# configure_cors). Everywhere else - the Docker Compose / production
# frontend image - this same variable defaults to the relative path /api
# instead (see infra/.env.example), since the browser reaches the backend
# through nginx's own reverse proxy there, same-origin, and never needs to
# know its hostname or port at all.
VITE_API_BASE_URL=http://localhost:8000
